# ============================================================================
#  .npmrc — configuración de pnpm para este proyecto
# ============================================================================

# Auto-instala peers (vite, react, etc.) sin pedir confirmación.
auto-install-peers=true

# Aprueba explícitamente los post-install scripts de estos paquetes.
# Sin esto, pnpm 10+ aborta con ERR_PNPM_IGNORED_BUILDS.
# Documentación: https://pnpm.io/settings#onlybuiltdependencies
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=sharp
