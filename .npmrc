# ============================================================================
#  .npmrc — configuración de pnpm para este proyecto
# ============================================================================

# Permite auto-instalar peers (vite, react, etc. los trae sin pedir).
auto-install-peers=true

# Aprueba explícitamente los post-install de estos paquetes.
# Sin esto, pnpm 10+ aborta con ERR_PNPM_IGNORED_BUILDS.
# SoloBuildDependencies en package.json es lo canónico, pero esto sirve
# para que el flag funcione también en CI/Docker sin paso interactivo.
allow-build[]=esbuild
allow-build[]=sharp
allow-build[]=@img/sharp-libvips-*
