# ============================================================================
#  .npmrc — configuración de pnpm para este proyecto
# ============================================================================

# Permite que esbuild y otros paquetes con post-install ejecuten sus scripts.
# Si no, pnpm 10+ aborta con ERR_PNPM_IGNORED_BUILDS.
enable-pre-post-scripts=true

# Acelera instalaciones en CI/Docker (no espera interactividad).
auto-install-peers=true
