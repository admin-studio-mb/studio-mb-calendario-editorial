# ============================================================================
#  Studio mb · Directus — Variables de entorno
# ----------------------------------------------------------------------------
#  Copia este archivo como `.env` en la misma carpeta del docker-compose.yml
#  y rellena los valores reales. NO commitees el `.env` real.
# ============================================================================

# --- Claves de aplicación ---------------------------------------------------
# Genera claves seguras con:  openssl rand -hex 32
KEY=                 # 64 chars hex — REEMPLAZAR
SECRET=              # 64 chars hex — REEMPLAZAR

# --- BBDD PostgreSQL GLOBAL --------------------------------------------------
# Esta BBDD ya existe en el servidor. Directus NO la crea.
DB_CLIENT=pg
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=studio_mb_calendario
DB_USER=studio_mb
DB_PASSWORD=               # REEMPLAZAR
DB_SSL=false

# --- Redis GLOBAL (cache + sesiones) -----------------------------------------
REDIS=redis://redis:6379
CACHE_ENABLED=true

# --- Admin inicial (solo se aplica la PRIMERA vez al arrancar) ---------------
ADMIN_EMAIL=admin@studiomb.es
ADMIN_PASSWORD=           # REEMPLAZAR
ADMIN_TOKEN=             # REEMPLAZAR (openssl rand -hex 32)

# --- Acceso público ---------------------------------------------------------
PUBLIC_URL=https://cms.studiomb.es
TELEMETRY=false

# --- Almacenamiento (uploads locales dentro del contenedor) -----------------
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=/directus/uploads
