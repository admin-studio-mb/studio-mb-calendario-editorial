# ============================================================================
#  Studio mb · Frontend — variables de entorno (ejemplo)
#  Copia a .env y rellena SESSION_COOKIE_SECRET antes de levantar.
# ============================================================================

# URL pública del CMS (lo que verá el navegador al pedir assets /auth/login)
PUBLIC_DIRECTUS_URL=https://cms.studiomb.es

# URL interna Docker (evita salir a internet en cada fetch).
# Resolución por nombre de contenedor dentro de la red `servicios-internos`.
DIRECTUS_INTERNAL_URL=http://studio-mb-directus:8055

# Nombre de la cookie de sesión (debe coincidir con el backend).
SESSION_COOKIE_NAME=studio_mb_session

# Secret HMAC para firmar la cookie. Generar con:
#   openssl rand -hex 32
SESSION_COOKIE_SECRET=

# ── Notificaciones ──────────────────────────────────────────────────────────
# Token estático de un admin (server-side). Necesario para crear
# notificaciones para otros usuarios y limpiar la caché de Directus.
PUBLIC_DIRECTUS_STATIC_TOKEN=

# SMTP para los emails de notificación. Si faltan host/user/pass, solo
# funcionará la campanita (los emails se omiten sin romper nada).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Studio mb <no-reply@studiomb.es>
# "true" para SSL directo (puerto 465); vacío = auto por puerto.
SMTP_SECURE=
