---
// ============================================================================
//  Dashboard principal — SSR.
// ============================================================================
import Layout from '../../layouts/Layout.astro';
import DashboardShell from '../../components/DashboardShell.jsx';
import EditPostModal from '../../components/EditPostModal.jsx';
import Kpis from '../../components/Kpis.jsx';
import { env } from '../../lib/env.js';
import { normalizarPrefs } from '../../lib/prefs.js';

export const prerender = false;

const { user, token } = Astro.locals;
// Rol Cliente: no crea publicaciones; solo ve su calendario/mockup y confirma
// desde el modal de cada post. El resto (equipo) tiene la vista completa.
const esCliente = user?.role?.name === 'Cliente';
const baseHeaders = token ? { Authorization: `Bearer ${token}` } : {};
const baseUrl = env.DIRECTUS_INTERNAL_URL;

async function fetchCollection(path) {
  // `cache: 'no-store'` evita el cache HTTP intermedio. OJO: el cache de
  // Directus (Redis) es otro — ése se invalida con POST /utils/cache/clear
  // tras cada mutación (ver src/lib/cache.js y AGENTS.md §6.7).
  const url = `${baseUrl}/items/${path}?limit=-1`;
  const res = await fetch(url, { headers: baseHeaders, cache: 'no-store' });
  if (!res.ok) {
    console.error(`[dashboard] ${path} → ${res.status}`);
    return [];
  }
  const json = await res.json();
  return json.data ?? [];
}

const [publicacionesRaw, clientes] = await Promise.all([
  fetchCollection('publicaciones'),
  fetchCollection('clientes'),
]);

const publicaciones = publicacionesRaw.map((p) => ({
  ...p,
  cliente: p.cliente_id ?? null,
}));

// Comentarios: los carga el cliente on-demand según el post seleccionado.
const initialFeed = publicaciones.slice(0, 9);

// Preferencias de UI del usuario (panel "Nueva publicación" fijo o modal).
const prefs = normalizarPrefs(user?.preferencias);
---
<Layout title="Calendario · Studio mb" user={user}>
  {/* Hero */}
  <header class="mb-8">
    <h1 class="text-2xl md:text-3xl font-bold text-ink-900 tracking-tight">
      Calendario editorial
    </h1>
    <p class="mt-1 text-sm text-ink-500">
      Vista global de las publicaciones programadas para tus clientes.
    </p>
  </header>

  {/* KPIs (reaccionan al cursor del calendario) */}
  <Kpis client:load />

  <DashboardShell
    client:load
    publicaciones={publicaciones}
    clientes={clientes}
    initialFeed={initialFeed}
    mostrarPanel={prefs.panelNueva !== false}
    puedeCrear={!esCliente}
  />

  <EditPostModal client:load clientes={clientes} currentUser={user} />
</Layout>
