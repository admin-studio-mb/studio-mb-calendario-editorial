---
// ============================================================================
//  /dashboard/usuarios — gestión de usuarios (solo Administrator).
// ============================================================================
import Layout from '../../../layouts/Layout.astro';
import UsuariosView from '../../../components/UsuariosView.jsx';
import { directusFetch } from '../../../lib/directus-fetch.js';
import { esAdmin } from '../../../lib/roles.js';

export const prerender = false;

const { user, token } = Astro.locals;
// Solo el Administrator gestiona usuarios.
if (!esAdmin(user)) return Astro.redirect('/dashboard');

async function fetchUsers() {
  const r = await directusFetch({
    path: '/users',
    method: 'GET',
    token,
    search: {
      fields: 'id,email,first_name,last_name,status,role.id,role.name,cliente_id',
      limit: '-1',
      sort: 'email',
    },
  });
  if (!r.ok) {
    console.error('[dashboard/usuarios] users →', r.status);
    return [];
  }
  return Array.isArray(r.data) ? r.data : [];
}

async function fetchClientes() {
  const r = await directusFetch({
    path: '/items/clientes',
    method: 'GET',
    token,
    search: { limit: '-1', fields: 'id,nombre' },
  });
  if (!r.ok) {
    console.error('[dashboard/usuarios] clientes →', r.status);
    return [];
  }
  return Array.isArray(r.data) ? r.data : [];
}

const [usuarios, clientes] = await Promise.all([fetchUsers(), fetchClientes()]);
---
<Layout title="Usuarios · Studio mb" user={user}>
  <header class="mb-8">
    <h1 class="text-2xl md:text-3xl font-bold text-ink-900 tracking-tight">Usuarios</h1>
    <p class="mt-1 text-sm text-ink-500">
      Da de alta clientes, editores y administradores, y asigna cada cliente a su usuario.
    </p>
  </header>

  <UsuariosView
    client:load
    initialUsuarios={usuarios}
    clientes={clientes}
    currentUserId={user.id}
  />
</Layout>
