---
// ============================================================================
//  /dashboard/configuracion — preferencias de UI por usuario (todos los roles).
// ============================================================================
import Layout from '../../../layouts/Layout.astro';
import ConfiguracionView from '../../../components/ConfiguracionView.jsx';
import { normalizarPrefs } from '../../../lib/prefs.js';

export const prerender = false;

const { user } = Astro.locals;
const prefs = normalizarPrefs(user?.preferencias);
---
<Layout title="Configuración · Studio mb" user={user}>
  <header class="mb-8">
    <h1 class="text-2xl md:text-3xl font-bold text-ink-900 tracking-tight">Configuración</h1>
    <p class="mt-1 text-sm text-ink-500">
      Opciones de la interfaz. Se guardan en tu cuenta y solo te afectan a ti.
    </p>
  </header>

  <ConfiguracionView client:load initialPrefs={prefs} />
</Layout>
