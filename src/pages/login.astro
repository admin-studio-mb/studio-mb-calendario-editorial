---
// ============================================================================
//  Página de login — split screen con branding a la izquierda.
// ============================================================================
import Layout from '../layouts/Layout.astro';

const next = Astro.url.searchParams.get('next') ?? '/dashboard';
const error = Astro.url.searchParams.get('error');
const errorMsg = error === 'missing'
  ? 'Introduce email y contraseña.'
  : error === 'invalid'
  ? 'Credenciales incorrectas.'
  : null;
---
<Layout title="Iniciar sesión · Studio mb" user={null}>
  <div class="min-h-screen w-full grid grid-cols-1 lg:grid-cols-2 -mx-4 md:-mx-8 -my-6 md:-my-10">
    {/* Branding pane */}
    <aside class="relative hidden lg:flex flex-col justify-between p-12 bg-gradient-to-br from-brand-700 via-brand-600 to-indigo-500 text-white overflow-hidden">
      {/* Decorative shapes */}
      <div class="absolute -top-32 -right-32 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-0 -left-20 w-80 h-80 bg-white/5 rounded-full blur-2xl"></div>
      <div class="absolute top-1/2 right-12 grid grid-cols-7 gap-1.5 opacity-30">
        {Array.from({ length: 28 }).map(() => (
          <span class="w-2 h-2 bg-white rounded-full"></span>
        ))}
      </div>

      <div class="relative">
        <div class="inline-flex items-center gap-3">
          <span class="inline-flex w-12 h-12 items-center justify-center rounded-2xl bg-white/15 backdrop-blur-sm font-bold text-xl shadow-lg">
            mb
          </span>
          <div>
            <p class="font-semibold text-lg">Studio mb</p>
            <p class="text-xs uppercase tracking-widest text-white/70">Calendario Editorial</p>
          </div>
        </div>
      </div>

      <div class="relative max-w-md space-y-6">
        <h1 class="text-3xl xl:text-4xl font-bold leading-tight">
          Planifica la presencia social de tus clientes con calma.
        </h1>
        <p class="text-white/80 leading-relaxed">
          Vista global del calendario, mockups de feed y feedback del equipo en un solo sitio.
        </p>
        <ul class="space-y-3 text-sm text-white/90">
          <li class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            Calendario mensual por cliente
          </li>
          <li class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            Mockup del feed antes de publicar
          </li>
          <li class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-lg bg-white/15 flex items-center justify-center">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            Comentarios y aprobaciones del equipo
          </li>
        </ul>
      </div>

      <p class="relative text-xs text-white/60">© {new Date().getFullYear()} Studio mb — herramienta interna</p>
    </aside>

    {/* Form pane */}
    <main class="flex items-center justify-center p-6 md:p-12 bg-white">
      <div class="w-full max-w-sm space-y-8">
        <header class="lg:hidden flex items-center gap-3 mb-8">
          <span class="inline-flex w-10 h-10 items-center justify-center rounded-xl bg-gradient-to-br from-brand-500 to-brand-700 text-white font-bold">mb</span>
          <p class="font-semibold text-ink-900">Studio mb</p>
        </header>

        <div>
          <h2 class="text-2xl font-bold text-ink-900">Bienvenido de vuelta</h2>
          <p class="text-sm text-ink-500 mt-1">Entra con tu cuenta de Directus.</p>
        </div>

        {errorMsg && (
          <div class="rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm p-3 flex items-start gap-2">
            <svg class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            <span>{errorMsg}</span>
          </div>
        )}

        <form method="POST" action="/api/auth/login" class="space-y-4">
          <input type="hidden" name="next" value={next} />

          <label class="block">
            <span class="block text-xs font-semibold uppercase tracking-wider text-ink-500 mb-1.5">Email</span>
            <input
              name="email"
              type="email"
              required
              autocomplete="username"
              placeholder="tu@email.com"
              class="w-full px-3.5 py-2.5 rounded-lg border border-ink-200 bg-white text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 focus:outline-none transition"
            />
          </label>

          <label class="block">
            <span class="block text-xs font-semibold uppercase tracking-wider text-ink-500 mb-1.5">Contraseña</span>
            <input
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full px-3.5 py-2.5 rounded-lg border border-ink-200 bg-white text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-100 focus:outline-none transition"
            />
          </label>

          <button
            type="submit"
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-gradient-to-br from-brand-600 to-brand-700 text-white text-sm font-medium shadow-sm hover:shadow-md hover:from-brand-700 hover:to-brand-800 transition"
          >
            Entrar
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </button>
        </form>

        <p class="text-xs text-ink-400 text-center">
          ¿Olvidaste la contraseña? Pídele a un admin que la resetee en Directus.
        </p>
      </div>
    </main>
  </div>
</Layout>
