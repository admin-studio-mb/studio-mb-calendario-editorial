# ============================================================================
#  Studio mb · Calendario Editorial — Frontend (Astro)
# ----------------------------------------------------------------------------
#  Variables consumidas por el código en src/lib/directus.js.
#  Copia este archivo como `.env` en la RAÍZ del proyecto Astro.
# ============================================================================

# URL pública de la API de Directus (resuelta por Nginx Proxy Manager).
PUBLIC_DIRECTUS_URL=https://calendar.studiomb.es

# URL del SSR para llamadas internas (mismo host, sin pasar por NPM).
DIRECTUS_INTERNAL_URL=http://studio-mb-directus:8055

# Token estático de un usuario con permisos de lectura para SSR público
# (opcional — si lo dejamos vacío usamos siempre el JWT del usuario).
PUBLIC_DIRECTUS_STATIC_TOKEN=

# Secreto de la cookie de sesión (genera con openssl rand -hex 32).
SESSION_COOKIE_SECRET=          # REEMPLAZAR

# Nombre de la cookie HttpOnly donde guardamos el JWT de Directus.
SESSION_COOKIE_NAME=studio_mb_session
